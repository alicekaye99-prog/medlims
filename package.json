  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "dexie": "^4.4.4",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.3.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}